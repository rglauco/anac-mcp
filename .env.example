# ANAC Procurement Intelligence MCP Server
# Environment configuration example
#
# No API keys required — ANAC data is fully public.
# Copy this file to .env and adjust as needed.

# ─────────────────────────────────────────────
# Server configuration
# ─────────────────────────────────────────────

# Host and port for the uvicorn server
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────
# Optional tuning
# ─────────────────────────────────────────────

# Maximum requests per minute to ANAC API (default: 20)
# Reduce if you see rate limiting errors from ANAC
RATE_LIMIT_PER_MINUTE=20

# HTTP timeout in seconds for ANAC API calls (default: 45)
ANAC_TIMEOUT=45
